extends SceneTree
var passed := 0
var failed := 0
func check(ok:bool, label:String):
	if ok: passed+=1; print("PASS ",label)
	else: failed+=1; printerr("FAIL ",label)
func _initialize():
	var helper=load("res://scripts/menu_slider_pointer.gd").new()
	var panel:=Transform3D(Basis(Vector3.UP,.5),Vector3(2,1,-2))
	var targets:Array=[{"id":3,"rect":Rect2(-.45,-.025,.9,.05),"slider":true},{"id":5,"rect":Rect2(-.6,.15,1.2,.1),"slider":false}]
	var direction:Vector3=panel.basis*Vector3.FORWARD
	var origin:Vector3=panel*Vector3(0,0,.5)
	var result:Dictionary=helper.step("right",origin,direction,1,true,panel,targets)
	check(not result.pressed and helper.captured_hand.is_empty(),"held trigger on initial activation is disarmed")
	helper.step("right",origin,direction,0,true,panel,targets)
	result=helper.step("right",origin,direction,1,true,panel,targets)
	check(result.pressed and result.dragging and result.index==3 and is_equal_approx(result.value,.5),"fresh trigger captures midpoint on transformed panel")
	helper.step("left",origin,direction,0,true,panel,targets)
	result=helper.step("left",origin,direction,1,true,panel,targets)
	check(not result.pressed and helper.captured_hand=="right","second hand cannot steal drag capture")
	result=helper.step("right",panel*Vector3(.9,.4,.5),direction,1,true,panel,targets)
	check(result.dragging and result.hovered==-1 and result.value==1,"captured drag outside track clamps to maximum")
	result=helper.step("right",panel*Vector3(-.9,.4,.5),direction,1,true,panel,targets)
	check(result.value==0,"captured drag clamps to minimum")
	result=helper.step("right",origin,panel.basis*Vector3.RIGHT,1,true,panel,targets)
	check(result.dragging and not result.hit and result.value==-1,"parallel ray preserves capture without inventing slider value")
	result=helper.step("right",panel*Vector3(.9,.4,.5),direction,0,true,panel,targets)
	check(result.released and helper.captured_hand.is_empty(),"release outside ends drag")
	result=helper.step("left",origin,direction,1,true,panel,targets)
	check(not result.pressed,"other alreadyheld trigger does not capture after release")
	helper.step("right",origin,direction,1,true,panel,targets)
	result=helper.step("right",origin,direction,1,false,panel,targets)
	check(result.released and helper.captured_hand.is_empty(),"tracking loss cancels capture")
	result=helper.step("right",origin,direction,1,true,panel,targets)
	check(not result.pressed,"tracking recovery requires trigger release")
	helper.step("right",origin,direction,0,true,panel,targets)
	result=helper.step("right",panel*Vector3(0,.2,.5),direction,1,true,panel,targets)
	check(result.pressed and result.index==5 and not result.dragging,"categorical target emits one fresh click")
	result=helper.step("right",panel*Vector3(0,.2,.5),direction,1,true,panel,targets)
	check(not result.pressed,"held categorical click never repeats")
	helper.reset()
	result=helper.step("right",origin,direction,1,true,panel,targets)
	check(not result.pressed and helper.captured_hand.is_empty(),"reset disarms pointer until neutral")
	print("MENU_POINTER_RESULT passes=",passed," failures=",failed)
	quit(0 if failed==0 else 1)
