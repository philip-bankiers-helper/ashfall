config_version=5

[application]
config/name="ASHFALL - The Last Relay"
config/version="1.0.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/use_custom_user_dir=true
config/custom_user_dir_name="AshfallVR-Public1000"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
textures/default_filters/anisotropic_filtering_level=2

[xr]
openxr/enabled=true
openxr/startup_alert=false
shaders/enabled=true

[audio]
driver/mix_rate=48000

[physics]
common/physics_ticks_per_second=90

[ashfall]
awp_zoom_damping_experiment=true









